{
  "manifest_version": 3,
  "name": "Thundergif",
  "version": "1.0.0",
  "description": "Search GIPHY or KLIPY and insert a GIF into the email you are writing.",
  "browser_specific_settings": {
    "gecko": {
      "id": "thundergif@w1bbsy.github.io",
      "strict_min_version": "140.0"
    }
  },
  "icons": {
    "32": "icons/thundergif-32.png",
    "64": "icons/thundergif-64.png",
    "128": "icons/thundergif-128.png"
  },
  "compose_action": {
    "default_popup": "picker/picker.html",
    "default_title": "Insert a GIF",
    "default_icon": {
      "16": "icons/toolbar-light-16.png",
      "32": "icons/toolbar-light-32.png"
    },
    "default_area": "maintoolbar",
    "theme_icons": [
      {
        "light": "icons/toolbar-dark-16.png",
        "dark": "icons/toolbar-light-16.png",
        "size": 16
      },
      {
        "light": "icons/toolbar-dark-32.png",
        "dark": "icons/toolbar-light-32.png",
        "size": 32
      }
    ]
  },
  "options_ui": {
    "page": "settings/settings.html"
  },
  "permissions": [
    "storage",
    "compose",
    "scripting"
  ],
  "host_permissions": [
    "https://api.giphy.com/*",
    "https://media.giphy.com/*",
    "https://media0.giphy.com/*",
    "https://media1.giphy.com/*",
    "https://media2.giphy.com/*",
    "https://media3.giphy.com/*",
    "https://media4.giphy.com/*",
    "https://i.giphy.com/*",
    "https://api.klipy.com/*",
    "https://static.klipy.com/*",
    "https://static1.klipy.com/*",
    "https://static2.klipy.com/*"
  ],
  "experiment_apis": {
    "thundergifCompose": {
      "schema": "experiments/compose/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "thundergifCompose"
          ]
        ],
        "script": "experiments/compose/implementation.js"
      }
    }
  }
}
